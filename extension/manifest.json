{
  "manifest_version": 3,
  "name": "Wildberries Analytics — аналитика продаж",
  "version": "1.0.0",
  "description": "Добавляет блок аналитики продаж (скорость, выручка, динамика цены) на страницы поиска и карточек товаров Wildberries.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "*://*.wildberries.ru/*",
    "*://wildberries.ru/*",
    "https://card.wb.ru/*",
    "https://search.wb.ru/*",
    "http://127.0.0.1:4000/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.wildberries.ru/catalog/*",
        "*://wildberries.ru/catalog/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WB Analytics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
